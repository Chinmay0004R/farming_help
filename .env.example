# Django Security Settings
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# Secret key for Django (generate a new one for production)
# You can generate a new key with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=your-secret-key-here

# Debug mode (set to False in production)
DEBUG=True

# Allowed hosts (comma-separated for production)
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (if using external DB)
# DATABASE_URL=sqlite:///db.sqlite3
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-password
EMAIL_USE_TLS=True

# Weather API Settings
WEATHER_CACHE_SECONDS=900

# ESP32 IoT Configuration
ESP32_API_URL=http://localhost:8000/iot/readings/

# Security Settings for Production
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
